theme_clockwise() +
theme(text = element_text(family = "Helvetica")) +
guides(fill=FALSE, color=FALSE)
library(ggtern)
library(dplyr)
library(ggplot2)
data <- data.frame (Clay=c(1,0.55,0.40,0.40,0.60,0.55,0.35,0.35),
Sand=c(0,0.45,0.45,0.20,0,0.45,0.65,0.45),
Silt=c(0,0,0.15,0.40,0.40,0,0,0.20),
Label=c("Clay","Clay","Clay","Clay","Clay", "Sandy Clay","Sandy Clay","Sandy Clay")
)
data_text <- data  %>% group_by(Label) %>%
summarise_if(is.numeric, mean, na.rm = TRUE)
soil_data <- data.frame(
soil= c("a", "b", "c", "d"),
sand = c(15, 18, 57, 32),
silt = c(52, 70, 8, 26),
clay = c(33, 12, 35, 42)
)
ggplot(data = data, aes(
y = Clay,
x = Sand,
z = Silt
)) +
coord_tern(L = "x", T = "y", R = "z") +
geom_polygon(
aes(fill = Label),
alpha = 0.0,
size = 0.5,
color = "black"
) +
geom_text(data = data_text,
aes(label = Label, alpha = 0.8,),
color = 'black',
size = 2)   +
geom_point(  #<<
data = soil_data,
aes(x = sand,
y = clay,
z = silt
)
) +
theme_showarrows() +
theme_clockwise() +
theme(text = element_text(family = "Helvetica")) +
guides(fill=FALSE, color=FALSE)
